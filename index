class Game:
    def __init__(self):
        self.player = None

    # ---------- 开局 ----------
    def 开局(self):
        print("=" * 60)
        print("　　　　　《小花仙养成模拟器》")
        print("　　　　—— 拉贝尔大陆的童话冒险 ——")
        print("=" * 60)
        print("\n你是一个生活在地球小镇的普通孩子。")
        print("某天，你在放学路上发现了一朵会发光的花。")
        print("当你轻轻触碰它时，一道温暖的光把你包围……")
        print("等你睁开眼，已经来到了一个叫【拉贝尔大陆】的奇妙世界。")
        print("\n这里生活着花仙精灵王，也隐藏着黑暗的威胁。")
        print("普普拉花神守护着这片土地，古灵仙族与花仙魔法使者们并肩作战。")
        print("而你，将在这里展开属于自己的花仙冒险。")
        print("\n据说，只有心灵纯净、勇气与智慧并存的人，")
        print("才能与精灵王缔结契约，点亮花之法典。")
        input("\n按回车键，开始你的冒险……")

        name = input("请给你的角色起个名字（直接回车则使用默认名“小花仙”）：").strip()
        if not name:
            name = "小花仙"
        self.player = Player(name)
        print(f"\n欢迎你，{self.player.name}！")
        print("你从地球意外闯入拉贝尔大陆，心中既紧张又期待。")
        print("远处，古灵仙地的花朵正在微风中轻轻摇曳……\n")
        self.player.打印状态()

    # ---------- 地点切换 ----------
    def 前往某地(self):
        p = self.player
        print("\n你想去哪里？")
        for i, loc in enumerate(LOCATIONS, 1):
            print(f"{i}. {loc}")
        print("0. 返回")
        try:
            choice = int(input("请选择："))
        except ValueError:
            print("请输入数字哦～")
            return
        if choice == 0:
            return
        if 1 <= choice <= len(LOCATIONS):
            p.当前所在地点 = LOCATIONS[choice - 1]
            print(f"\n你来到了【{p.当前所在地点}】。")
            # 不同地点触发不同氛围描述
            描述 = {
                "地球小镇": "熟悉的街道，但似乎多了一丝花仙的气息。",
                "古灵仙地": "古老的大树与发光的花丛，空气中充满灵力。",
                "花蕾亚学院": "花仙们学习魔法的地方，走廊里飘着花香。",
                "勇气国": "炽热的熔岩与坚强的岩石，这里是勇气的试炼场。",
                "遗忘之地": "灰雾弥漫，被遗忘的记忆碎片在风中飘荡。"
            }
            print(描述.get(p.当前所在地点, ""))
            # 到达新地点后，随机触发一个小事件
            if random.random() < 0.5:
                print("\n这里似乎有什么事情要发生……")
                self.触发随机事件()
        else:
            print("没有这个地点哦。")

    # ---------- 修炼魔法 ----------
    def 修炼魔法(self):
        p = self.player
        print("\n你找了一处安静的地方，开始修炼花仙魔法。")
        time.sleep(0.5)
        收益 = random.randint(3, 8)
        p.修改属性(魔力=收益, 智慧=1)
        print(f"经过一番修炼，你的花仙魔力提升了 {收益} 点，智慧值 +1。")
        # 小概率遇到精灵王指点
        if random.random() < 0.2:
            king = random.choice(list(SPIRIT_KINGS.keys()))
            info = SPIRIT_KINGS[king]
            print(f"\n这时，{king} 出现了！")
            print(f"{king}：“{info['台词']}”")
            print(f"你从 {king} 的指点中获得了额外的感悟。")
            p.修改属性(魔力=5)
            print("花仙魔力额外 +5。")
        p.打印状态()

    # ---------- 随机事件 ----------
    def 触发随机事件(self):
        p = self.player
        # 根据心花状态调整危机事件概率
        if p.心花状态 == "璀璨":
            危机概率 = 0.4
        elif p.心花状态 == "微弱":
            危机概率 = 0.55
        else:
            危机概率 = 0.7

        if random.random() < 危机概率:
            event = random.choice(CRISIS_EVENTS)
            self.处理危机事件(event)
        else:
            event = random.choice(POSITIVE_EVENTS)
            self.处理正面事件(event)

    # ---------- 正面事件 ----------
    def 处理正面事件(self, event):
        p = self.player
        print(f"\n【正面事件：{event}】")

        if event == "遇见夏安安小队":
            print("你遇见了夏安安、千韩、伊瞳和淑馨。")
            print("夏安安：“你好呀！我们是花仙魔法使者，一起守护拉贝尔吧！”")
            print("1. 和夏安安一起练习魔法（智慧+2，魔力+3）")
            print("2. 和千韩一起照顾花朵（爱心+3）")
            print("3. 和伊瞳一起练习变身（美丽+3，魔力+2）")
            print("4. 和淑馨一起研究花之法典（智慧+3）")
            choice = self.获取选项(4)
            if choice == 1:
                p.修改属性(智慧=2, 魔力=3)
                print("你和夏安安一起练习，魔法更加熟练了！")
            elif choice == 2:
                p.修改属性(爱心=3)
                print("千韩教你用爱心浇灌花朵，花朵开得更艳了。")
            elif choice == 3:
                p.修改属性(美丽=3, 魔力=2)
                print("伊瞳帮你调整变身姿势，你变得更自信了。")
            elif choice == 4:
                p.修改属性(智慧=3)
                print("淑馨给你讲解花之法典，你受益匪浅。")

        elif event == "接受精灵王考验":
            # 随机选一个未收服的精灵王
            未收服 = [k for k in SPIRIT_KINGS if k not in p.已收服精灵王]
            if not 未收服:
                print("所有已知的精灵王都已经被你收服了，暂时没有新的考验。")
                p.修改属性(魔力=3)
                print("你回顾过去的契约，魔力 +3。")
            else:
                king = random.choice(未收服)
                info = SPIRIT_KINGS[king]
                print(f"你遇到了精灵王【{king}】。")
                print(f"{king}：“{info['台词']}”")
                print(f"考验内容：{info['考验']}")
                print("1. 勇敢接受考验")
                print("2. 先观察一下再决定")
                print("3. 暂时离开")
                choice = self.获取选项(3)
                if choice == 1:
                    self.精灵王考验(king)
                elif choice == 2:
                    print("你仔细观察，发现考验中隐藏的细节。")
                    p.修改属性(智慧=2)
                    print("智慧 +2。你决定下次再来挑战。")
                else:
                    print("你礼貌地告别了精灵王。")

        elif event == "修炼花仙魔法":
            print("你感受到周围的花仙魔力在流动。")
            print("1. 专注提升魔力（魔力+5）")
            print("2. 平衡修炼（爱心+1，美丽+1，智慧+1，魔力+2）")
            print("3. 尝试高难度魔法（成功率50%，成功魔力+10，失败魔力-3）")
            choice = self.获取选项(3)
            if choice == 1:
                p.修改属性(魔力=5)
                print("你的魔力稳定提升。")
            elif choice == 2:
                p.修改属性(爱心=1, 美丽=1, 智慧=1, 魔力=2)
                print("你全面修炼，状态更加均衡。")
            else:
                if random.random() < 0.5:
                    p.修改属性(魔力=10)
                    print("你成功施展了高难度魔法！魔力大幅提升！")
                else:
                    p.修改属性(魔力=-3)
                    print("魔法失控了，你受到一点反噬，魔力 -3。")

        elif event == "花圃照料花朵":
            print("你来到一片花圃，花朵们正需要照料。")
            print("1. 浇水施肥（爱心+2，魔力+2）")
            print("2. 用魔法催开花朵（魔力-2，美丽+3）")
            print("3. 静静陪伴花朵（爱心+3，智慧+1）")
            choice = self.获取选项(3)
