                p.修改属性(爱心=2, 魔力=2)
                print("花朵们恢复了生机，你也感到心情舒畅。")
            elif choice == 2:
                p.修改属性(魔力=-2, 美丽=3)
                print("花朵绽放出美丽的光彩，但你也消耗了一些魔力。")
            else:
                p.修改属性(爱心=3, 智慧=1)
                print("你静静地陪伴花朵，感受到生命的智慧。")

        p.打印状态()

    # ---------- 精灵王考验 ----------
    def 精灵王考验(self, king):
        p = self.player
        info = SPIRIT_KINGS[king]
        print(f"\n你开始接受 {king} 的考验：{info['考验']}")

        # 根据精灵王特点设计不同判定
        if king == "椿":
            print("你耐心地照料椿树，日复一日。")
            print("1. 坚持到底")
            print("2. 中途放弃")
            choice = self.获取选项(2)
            if choice == 1 and p.爱心值 >= 15:
                self.缔结契约(king)
