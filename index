    # ---------- 净化战斗 ----------
    def 净化战斗(self, shadow_name):
        p = self.player
        print(f"\n⚔️ 你与 {shadow_name} 展开净化之战！")

        # 计算战斗力
        战斗力 = p.花仙魔力 + p.爱心值 // 2 + p.智慧值 // 2
        if p.当前守护精灵 != "无":
            战斗力 += 10
            print(f"{p.当前守护精灵} 与你并肩作战！战斗力 +10")
        if p.当前套装 != "花仙魔法使者套装":
            战斗力 += 5
            print(f"【{p.当前套装}】提供了额外力量，战斗力 +5")

        暗影强度 = random.randint(20, 45)
        print(f"你的战斗力：{战斗力}　暗影强度：{暗影强度}")

        if 战斗力 >= 暗影强度:
            print("你的净化魔法绽放出温暖的光芒！")
            print(f"{shadow_name} 被成功净化了！")
            if shadow_name not in p.已净化暗影:
                p.已净化暗影.append(shadow_name)
            p.修改属性(魔力=-8, 爱心=2, 美丽=2, 智慧=2)
            print("净化成功！全属性小幅提升，魔力消耗 8 点。")
        else:
            print("净化失败了……暗影的力量太强。")
            失败损失 = random.randint(8, 15)
            p.修改属性(魔力=-失败损失)
            p.降低心花(1)
            print(f"你受到反噬，魔力 -{失败损失}，心花状态下降。")
            if p.心花状态 == "熄灭":
                print("\n💔 你的心花完全熄灭了……")
                print("黑暗吞噬了你的光芒，游戏结束。")
                p.游戏结束 = True

        p.打印状态()

    # ---------- 换装变身 ----------
    def 换装变身(self):
        p = self.player
        print("\n你打开衣橱，准备换装变身。")
        print("可用套装：")
        for i, suit in enumerate(p.拥有变身套装, 1):
            print(f"{i}. {suit}")
        print("0. 返回")
        try:
            choice = int(input("请选择："))
        except ValueError:
            print("请输入数字哦～")
            return
        if choice == 0:
            return
        if 1 <= choice <= len(p.拥有变身套装):
            suit = p.拥有变身套装[choice - 1]
            p.变身(suit)
            p.打印状态()
        else:
            print("没有这套套装。")

    # ---------- 获得新套装（事件奖励） ----------
    def 获得套装(self, suit):
        p = self.player
        if suit not in p.拥有变身套装:
            p.拥有变身套装.append(suit)
            print(f"\n🎁 你获得了新套装：【{suit}】！")

    # ---------- 工具：获取选项 ----------
    def 获取选项(self, 数量):
        while True:
            try:
                choice = int(input(f"请选择（1-{数量}）："))
                if 1 <= choice <= 数量:
                    return choice
                else:
                    print(f"请输入 1 到 {数量} 之间的数字。")
            except ValueError:
                print("请输入数字哦～")

    # ---------- 主循环 ----------
    def 主循环(self):
        p = self.player
        while not p.游戏结束:
            print("\n" + "-" * 40)
            print("【主菜单】")
            print("1. 前往某地")
            print("2. 查看状态")
            print("3. 修炼魔法")
            print("4. 触发随机事件")
            print("5. 换装变身")
            print("6. 退出游戏")
            print("-" * 40)
            try:
                choice = int(input("请选择："))
            except ValueError:
                print("请输入数字哦～")
                continue

            if choice == 1:
                self.前往某地()
            elif choice == 2:
                p.打印状态()
            elif choice == 3:
                self.修炼魔法()
            elif choice == 4:
                self.触发随机事件()
            elif choice == 5:
                self.换装变身()
            elif choice == 6:
                print("\n感谢游玩《小花仙养成模拟器》！")
                print("愿你的心花永远璀璨，愿拉贝尔的花朵永远盛开。")
                break
            else:
                print("没有这个选项哦。")

            # 每回合检查游戏结束
            if p.游戏结束:
                print("\n" + "=" * 50)
                print("💔 游戏结束")
                print("你的心花熄灭了，黑暗暂时笼罩了拉贝尔。")
                print("但故事并没有结束——只要希望还在，花就会再次绽放。")
                print("=" * 50)
                break

            # 每回合小概率获得新套装
            if random.random() < 0.08:
                suit = random.choice(SUITS)
                self.获得套装(suit)


