class Player:
    """玩家角色，存储所有属性"""

    def __init__(self, name="小花仙"):
        self.name = name
        # 基础属性
        self.爱心值 = 20
        self.美丽值 = 20
        self.智慧值 = 20
        self.花仙魔力 = 50
        # 心花状态：璀璨 / 微弱 / 受损 / 熄灭
        self.心花状态 = "璀璨"
        # 已收服精灵王
        self.已收服精灵王 = []
        # 当前守护精灵
        self.当前守护精灵 = "无"
        # 当前所在地点
        self.当前所在地点 = "地球小镇"
        # 拥有变身套装
        self.拥有变身套装 = ["花仙魔法使者套装"]
        # 当前套装
        self.当前套装 = "花仙魔法使者套装"
        # 净化过的暗影精灵王
        self.已净化暗影 = []
        # 游戏是否结束
        self.游戏结束 = False

    # ---------- 状态面板 ----------
    def 打印状态(self):
        print("\n" + "=" * 50)
        print(f"【{self.name} 的状态面板】")
        print(f"所在地点：{self.当前所在地点}")
        print(f"爱心值：{self.爱心值}  美丽值：{self.美丽值}  智慧值：{self.智慧值}")
        print(f"花仙魔力：{self.花仙魔力}")
        print(f"心花状态：{self.心花状态}")
        print(f"当前守护精灵：{self.当前守护精灵}")
        print(f"当前套装：{self.当前套装}")
        if self.已收服精灵王:
            print(f"已收服精灵王：{'、'.join(self.已收服精灵王)}")
        else:
            print("已收服精灵王：暂无")
        if self.已净化暗影:
            print(f"已净化暗影精灵王：{'、'.join(self.已净化暗影)}")
        else:
            print("已净化暗影精灵王：暂无")
        print("=" * 50)

    # ---------- 属性修改 ----------
    def 修改属性(self, 爱心=0, 美丽=0, 智慧=0, 魔力=0):
        self.爱心值 = max(0, self.爱心值 + 爱心)
        self.美丽值 = max(0, self.美丽值 + 美丽)
        self.智慧值 = max(0, self.智慧值 + 智慧)
        self.花仙魔力 = max(0, self.花仙魔力 + 魔力)
        self.检查心花()

    def 检查心花(self):
        """根据魔力与三维检查心花状态"""
        if self.花仙魔力 <= 0:
            self.心花状态 = "熄灭"
            self.游戏结束 = True
            return
        if self.花仙魔力 < 15:
            self.心花状态 = "受损"
        elif self.花仙魔力 < 30:
            self.心花状态 = "微弱"
        else:
            self.心花状态 = "璀璨"

    def 降低心花(self, 程度=1):
        """直接降低心花状态"""
        顺序 = ["璀璨", "微弱", "受损", "熄灭"]
        当前 = 顺序.index(self.心花状态)
        新位置 = min(len(顺序) - 1, 当前 + 程度)
        self.心花状态 = 顺序[新位置]
        if self.心花状态 == "熄灭":
            self.游戏结束 = True

    # ---------- 换装变身 ----------
    def 变身(self, 套装名=None):
        """触发变身，打印台词，临时提升魔力"""
        if 套装名 and 套装名 in self.拥有变身套装:
            self.当前套装 = 套装名
        else:
            套装名 = self.当前套装

        台词库 = {
            "花仙魔法使者套装": "花仙魔法使者，变身！让花朵的力量汇聚于此！",
            "爱心花仙套装": "爱心花仙，变身！用温柔的心照亮黑暗！",
            "美丽花仙套装": "美丽花仙，变身！绽放吧，属于我的光芒！",
            "智慧花仙套装": "智慧花仙，变身！以知识为刃，以理性为盾！",
            "古灵仙族礼服": "古灵仙族之力，觉醒！守护拉贝尔的誓言！"
        }
        台词 = 台词库.get(套装名, "花仙魔法，变身！")
        print(f"\n✨ {台词}")
        print(f"你换上了【{套装名}】！")
        self.修改属性(魔力=8)
        print("变身带来临时魔力提升：+8")


