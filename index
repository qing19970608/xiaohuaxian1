    def 缔结契约(self, king):
        p = self.player
        if king not in p.已收服精灵王:
            p.已收服精灵王.append(king)
            p.当前守护精灵 = king
            print(f"\n🎉 恭喜！你通过了 {king} 的考验！")
            print(f"{king}：“从今以后，我愿意与你并肩作战。”")
            print(f"【{king}】已加入花之法典！")
            p.修改属性(魔力=10, 爱心=2, 美丽=2, 智慧=2)
            print("缔结契约带来全属性提升！")
        else:
            print(f"{king} 已经与你缔结过契约了。")
            p.修改属性(魔力=5)
            print("重温契约，魔力 +5。")

